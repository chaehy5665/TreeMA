{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treema.local/schemas/analysis/architecture/architecture_blueprint.schema.json",
  "title": "TreeMA Architecture Blueprint",
  "allOf": [
    { "$ref": "../artifact-metadata.schema.json" },
    {
      "type": "object",
      "required": ["modules", "flows", "buildOrder"],
      "properties": {
        "modules": { "type": "array", "items": { "type": "object" } },
        "flows": { "type": "array", "items": { "type": "object" } },
        "buildOrder": { "type": "array", "items": { "type": "string" } }
      }
    }
  ]
}
