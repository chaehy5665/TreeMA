{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treema.local/schemas/analysis/analysis/component_report.schema.json",
  "title": "TreeMA Component Report",
  "allOf": [
    { "$ref": "../artifact-metadata.schema.json" },
    {
      "type": "object",
      "required": [
        "componentId",
        "name",
        "type",
        "responsibility",
        "primaryFiles",
        "inputs",
        "outputs",
        "dependencies",
        "state",
        "risks",
        "missingPieces"
      ],
      "properties": {
        "componentId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "responsibility": { "type": "string" },
        "primaryFiles": { "type": "array", "items": { "type": "string" } },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "state": { "type": "object" },
        "risks": { "type": "array", "items": { "type": "string" } },
        "missingPieces": { "type": "array", "items": { "type": "string" } }
      }
    }
  ]
}
