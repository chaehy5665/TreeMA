{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treema.local/schemas/analysis/artifact-metadata.schema.json",
  "title": "TreeMA Analysis Artifact Metadata",
  "type": "object",
  "required": [
    "artifactType",
    "analysisVersion",
    "generatedAt",
    "observed",
    "inferred",
    "uncertain",
    "unknowns",
    "confidence"
  ],
  "properties": {
    "artifactType": { "type": "string", "minLength": 1 },
    "analysisVersion": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "observed": { "type": "array", "items": { "type": "string" } },
    "inferred": { "type": "array", "items": { "type": "string" } },
    "uncertain": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "modelProfile": { "type": "string" },
        "promptVersion": { "type": "string" },
        "stageMode": { "type": "string" },
        "generatedFromCache": { "type": "boolean" }
      }
    },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "claimRefs": { "type": "array", "items": { "type": "string" } }
  }
}
